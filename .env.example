# Copiar a .env y ajustar
AUTH_SECRET=   # obligatorio, 32 bytes o más: openssl rand -hex 32
AUTH_ENABLED=true
AUTH_USERS=operator:operator123:operator,admin:admin123:admin|operator,viewer:viewer123:viewer
STT_PROVIDER=echo            # echo | whisper | kichwa
STT_REPLICAS=1
STT_WORKERS=2
WHISPER_MODEL=base
TRANSLATION_PROVIDER=dictionary   # none | dictionary | google
GOOGLE_TRANSLATE_API_KEY=
ACTUATOR_DRIVER=simulator    # simulator | serial
SERIAL_PORT=/dev/ttyUSB0
INTER_COMMAND_MS=150
SIM_INTER_COMMAND_MS=150     # 0 para medir solo la arquitectura
LOG_LEVEL=INFO
GRAFANA_PASSWORD=admin
# credencial del bus de eventos (NATS): cámbiala en cualquier despliegue real
BUS_TOKEN=   # obligatorio: openssl rand -hex 32
# contraseñas de las bases de datos, una por servicio (ADR-014): cámbialas en cualquier despliegue real
AUTH_DB_PASSWORD=dev-auth-db
NLP_DB_PASSWORD=dev-nlp-db
SIGNS_DB_PASSWORD=dev-signs-db
ACTUATOR_DB_PASSWORD=dev-actuator-db
TELEMETRY_DB_PASSWORD=dev-telemetry-db
